# MARITIME AI Production Environment Variables

# Frontend (Vercel) Environment Variables
# Set this in Vercel Project Settings -> Environment Variables
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# Backend Environment Variables
# Set these in your backend hosting provider (Render, Railway, Fly.io, etc.)
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=https://your-maritime-ai.vercel.app
ALLOWED_ORIGINS=https://your-maritime-ai.vercel.app
DATA_MODE=LIVE
ENABLE_MOCK_FALLBACK=false

# Neon Serverless PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-snowy-pine-ae8ojpf0-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# External Live Data Feed Providers (Optional)
AISSTREAM_API_KEY=
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
