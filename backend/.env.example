API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
DATA_MODE=REALTIME_INFERENCE
DATABASE_URL=

# Live AIS vessel tracking (Get a free API key at https://aisstream.io)
AISSTREAM_API_KEY=

# Energy Information Administration API v2 (Get a free API key at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# In-memory market data cache TTL in seconds (default: 900 = 15 minutes)
MARKET_DATA_CACHE_TTL=900
